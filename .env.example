# Copy to .env and fill in. Nothing here is required for the synthetic-only pipeline.
HF_TOKEN=
WANDB_API_KEY=
OPENROUTER_API_KEY=      # optional: LLM fallback normalizer / paraphrases
MODEL_ID=openai/whisper-large-v3-turbo
DATA_DIR=data
OUTPUT_DIR=artifacts
HF_HOME=.hf
CUDA_VISIBLE_DEVICES=0
LOCAL_MODE=true
REMOTE_MODE=false
